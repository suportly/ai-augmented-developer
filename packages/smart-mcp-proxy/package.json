{
  "name": "@aiadev/smart-mcp-proxy",
  "version": "0.1.0",
  "description": "MCP server that runs shell commands and summarizes oversized output through a local Ollama model before returning it to the agent.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "smart-mcp-proxy": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/suportly/ai-augmented-developer.git",
    "directory": "packages/smart-mcp-proxy"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ollama",
    "token-economy",
    "aiadev"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.7.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
