{
  "name": "@aiadev/smart-mcp-proxy",
  "version": "0.4.0",
  "description": "MCP server, CLI and Claude Code PreToolUse hook that condense long command output deterministically (verbatim error lines + head/tail excerpt) before it reaches the agent. No model, no network.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "smart-mcp-proxy": "./dist/index.js",
    "smart-bash": "./dist/cli.js",
    "smart-bash-hook": "./dist/hook.js"
  },
  "files": [
    "dist",
    "BENCHMARK.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/suportly/ai-augmented-developer.git",
    "directory": "packages/smart-mcp-proxy"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "token-economy",
    "claude-code",
    "hooks",
    "aiadev"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
