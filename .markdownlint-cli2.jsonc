{
  // Markdownlint config. Kept lenient on purpose — the point is to catch
  // genuine mistakes (broken tables, malformed links, duplicate headings),
  // not to enforce a house style that fights the content of SKILL.md files.
  "config": {
    "default": true,

    // Line length: SKILL.md prose often wraps at ~100; don't fight that.
    "MD013": false,

    // Allow inline HTML (used for collapsible sections and <SUBAGENT-STOP>).
    "MD033": false,

    // Allow bare URLs inside prose (common in CREDITS / README).
    "MD034": false,

    // First line does not need to be a top-level heading (skills start
    // with YAML frontmatter).
    "MD041": false,

    // Duplicate headings across sibling sections are common in
    // templates (every article has "Rationale"), allow them.
    "MD024": { "siblings_only": true },

    // Allow emphasis as a heading (used sparingly).
    "MD036": false,

    // Trailing punctuation in headings is fine (e.g. "Why?").
    "MD026": false,

    // Blank-line-around-* rules are stylistic formatters that fight
    // existing SKILL.md / agent prose. They catch no real defect, so
    // they are disabled in favour of readability.
    "MD022": false,
    "MD031": false,
    "MD032": false,

    // Emphasis-as-heading patterns already disabled above; also turn
    // off the "bare URL" and "strong within strong" complaints that
    // trigger inside code examples.
    "MD038": false,
    "MD009": false,
    "MD010": false,
    "MD012": false,
    "MD037": false,
    "MD047": false,

    // MD040 (fenced code block language) and MD023 (heading indentation)
    // would require retroactive edits across legacy skills. Disabled —
    // reviewers still catch missing languages when it matters for
    // rendering.
    "MD040": false,
    "MD023": false
  },
  "ignores": [
    "node_modules/",
    ".venv/",
    "venv/",
    ".claude/",
    "presets/**/skills/",
    // Test fixtures replicate the canonical tasks.md grammar
    // (H1 title + ### TNNN rows) on purpose; they are data, not docs.
    "tests/fixtures/",
    // Ignore Markdown inside code fences of other Markdown files.
    "**/CHANGELOG.md.bak"
  ]
}
